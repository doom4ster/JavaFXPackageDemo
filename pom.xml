<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.senftresearch</groupId>
    <artifactId>JavaFXPackageDemo</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>JavaFXPackageDemo</name>

    <!-- 依建置所在的作業系統自動啟用，決定 jpackage 產出的格式。jpackage 無法跨平台，要哪個平台的安裝檔就得在該平台建置 -->
    <profiles>

        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <!-- Linux：免安裝的應用程式資料夾（不產生 deb/rpm） -->
                <app.package.type>APP_IMAGE</app.package.type>
            </properties>
        </profile>

        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <!-- Windows：EXE 安裝檔，建置機需要安裝 WiX Toolset -->
                <app.package.type>EXE</app.package.type>
            </properties>
        </profile>

        <profile>
            <id>macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <!-- macOS：DMG 磁碟映像 -->
                <app.package.type>DMG</app.package.type>
            </properties>
        </profile>

    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <javafx.version>21.0.6</javafx.version>
        <junit.version>5.12.1</junit.version>

        <!-- 打包用：安裝檔與 App 名稱、版本（jpackage 不接受 -SNAPSHOT，所以與 project version 分開） -->
        <app.name>JavaFXPackageDemo</app.name>
        <app.version>1.0.0</app.version>
        <!-- 模組化啟動類別，格式為「模組名稱/完整類別名稱」 -->
        <app.mainClass>io.senftresearch.javafxpackagedemo/io.senftresearch.javafxpackagedemo.HelloApplication</app.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- javafx:run 開發時執行；package 階段用 jlink 產生內含 JavaFX 的精簡 Java 執行環境 -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <!-- 放在 plugin 層級，讓命令列直接執行 javafx:run 時也讀得到 -->
                <configuration>
                    <mainClass>${app.mainClass}</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>create-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jlink</goal>
                        </goals>
                        <configuration>
                            <mainClass>${app.mainClass}</mainClass>
                            <!-- 產生 jlink-runtime/bin/app 啟動腳本 -->
                            <launcher>app</launcher>
                            <jlinkImageName>jlink-runtime</jlinkImageName>
                            <jlinkZipName>jlink-runtime</jlinkZipName>
                            <!-- 去掉用不到的檔案以縮小體積 -->
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 用 jlink 的執行環境做成各平台安裝檔，輸出到 target/jpackage/ -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.8.0</version>
                <executions>
                    <execution>
                    <!-- 與 jlink 同在 package 階段；同階段依 pom 宣告順序執行，jlink 在前，所以 runtime 已備妥 -->
                    <phase>package</phase>
                    <goals>
                        <goal>jpackage</goal>
                    </goals>
                    <configuration>
                        <name>${app.name}</name>
                        <type>${app.package.type}</type>
                        <appVersion>${app.version}</appVersion>
                        <destination>${project.build.directory}/jpackage</destination>
                        <module>${app.mainClass}</module>
                        <runtimeImage>
                            ${project.build.directory}/jlink-runtime
                        </runtimeImage>

                    </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
